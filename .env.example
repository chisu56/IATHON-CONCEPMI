# Configuración de IA para YaPilas!
# Copia este archivo como .env y coloca tu clave real en el servidor.
# La clave NUNCA se expone al navegador ni se sube a git.

# Opción principal: DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternativas opcionales (si no usas DeepSeek)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
